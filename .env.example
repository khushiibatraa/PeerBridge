# PeerBridge Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/peerbridge or MongoDB Atlas URI)
# If omitted or left empty in development, PeerBridge will automatically start an embedded in-memory MongoDB instance.
MONGODB_URI=

# JWT Secret for signing authentication tokens
JWT_SECRET=peerbridge_jwt_super_secret_dev_key_2026

# Client Origin (CORS)
CLIENT_URL=http://localhost:3000
